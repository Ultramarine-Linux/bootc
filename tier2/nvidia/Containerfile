# nvidia.sh pulls in its own prerequisites (gcc-c++, terra-release-nvidia)
RUN --mount=type=cache,target=/var/cache /usr/src/ultramarine-bootc/tier2/nvidia/nvidia.sh
LABEL readymade.prettyname_suffix=" (with NVIDIA Drivers)"