FROM ghcr.io/ultramarine-linux/desktop-bootc:rawhide
COPY . /usr/src/ultramarine-bootc/tier1/plasma
# Milou is required module for KRunner, upstream packaging forgot to depend
RUN --mount=type=cache,target=/var/cache dnf do -y \
    --no-best \
    --allowerasing \
    --action=remove \
    ultramarine-release-identity-basic \
    --action=install \
    ultramarine-release-identity-plasma \
    plasma-discover-flatpak \
    plasma-discover-rpm-ostree \
    plasma-discover-packagekit \
    @ultramarine-plasma-product-environment \
    plasma-browser-integration \
    plasma-milou \
    polycrystal \
    --exclude='desktop-backgrounds*' \
    --exclude='abrt*' \
    --exclude='libreoffice*' \
    --exclude=elisa-player \
    --exclude=haruna \
    --exclude=kate \
    --exclude=kfind \
    --exclude=kjournald \
    --exclude=kmail \
    --exclude=koko \
    --exclude=kolourpaint \
    --exclude=krfb \
    --exclude=kwrite \
    --exclude=okular \
    --setopt=install_weak_deps=False


# Apps that used to be RPMs get installed as Flatpaks on first boot instead.
# Overrides the shared list from ultramarine-release-identity-plasma, which
# also includes kolourpaint/kwrite that we don't want on bootc.
COPY polycrystal/ultramarine-plasma.json /etc/polycrystal/entries/ultramarine-plasma.json
RUN systemctl enable polycrystal.service

# HACK: Disable PackageKit backend for bootc installs
RUN mv /usr/lib64/qt6/plugins/discover/packagekit-backend.so /usr/lib64/qt6/plugins/discover/packagekit-backend.so.disabled

# HACK:
# for some reason qtvirtualkeyboard is not getting installed properly
# but it is required for plasma-keyboard to actually work
RUN --mount=type=cache,target=/var/cache dnf do -y \
    --action=reinstall \
    qt6-qtvirtualkeyboard
    
RUN sed -i 's/^livesys_session=.*/livesys_session="kde"/' /etc/sysconfig/livesys


LABEL readymade.prettyname="Ultramarine Plasma Edition"
