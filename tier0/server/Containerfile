FROM ghcr.io/ultramarine-linux/base-bootc:main

# Only install packages here. Service enablement, presets and other
# configuration ship in ultramarine-system-configs-server, so mutable installs
# made from this image keep receiving them through dnf.

# todo: move the udev rules stuff into a hardware support group

RUN --mount=type=cache,target=/var/cache dnf do -y \
    --no-best \
    --allowerasing \
    --action install \
    podman \
    podman-docker \
    container-selinux \
    tuned-ppd \
    powertop \
    btop \
    tetra \
    ultramarine-server-oobe \
    ultramarine-system-configs-server \
    terra-caddy \
    cage \
    wpewebkit \
    cog \
    cloudflared \
    tuned-profiles-atomic \
    tuned-profiles-cpu-partitioning \
    tuned-profiles-realtime \
    tailscale \
    podlet
